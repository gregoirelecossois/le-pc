{
  "name": "le-pc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Jeu pedagogique 3D : decouvrir, nommer et monter une unite centrale (college)",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "build:offline": "node ./node_modules/vite/bin/vite.js build --mode offline",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "three": "$three"
  }
}
